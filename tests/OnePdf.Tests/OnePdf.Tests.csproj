<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately call blocking and token-defaulted APIs of the library under test. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fuzz target body doubles as a deterministic mutation smoke test. -->
    <Compile Include="../../fuzz/OnePdf.Fuzz/FilterTarget.cs" Link="Filters/FilterTarget.cs" />
    <Compile Include="../../fuzz/OnePdf.Fuzz/FontTargets.cs" Link="Fonts/FontTargets.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePdf/OnePdf.csproj" />
    <ProjectReference Include="../../src/OnePdf.Fonts/OnePdf.Fonts.csproj" />
  </ItemGroup>

</Project>
