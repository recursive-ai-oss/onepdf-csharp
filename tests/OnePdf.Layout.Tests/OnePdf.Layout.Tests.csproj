<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Layout.Tests</RootNamespace>
    <AssemblyName>$(LibName).Layout.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately call blocking and token-defaulted APIs of the library under test. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Test-only: a second reader that must still open what the layout writes. -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePdf/OnePdf.csproj" />
    <ProjectReference Include="../../src/OnePdf.Layout/OnePdf.Layout.csproj" />
  </ItemGroup>

</Project>
