<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Used by the test, benchmark and fuzz projects only. The libraries depend on nothing outside the shared framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <!-- Compared against as compiled packages in the benchmarks and the extraction-quality tool; black boxes. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>
</Project>
