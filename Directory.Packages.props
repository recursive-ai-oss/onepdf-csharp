<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shaping package of the same family; Layout is the only library project that references it. -->
    <PackageVersion Include="RecursiveAI.OneFont" Version="1.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Used by the test, benchmark and fuzz projects only. The libraries depend on nothing outside the shared framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.1.0" />
    <PackageVersion Include="RecursiveAI.OneImage.Pdf" Version="1.7.0" />
    <!-- SVG comparison tool only; newer than the PDF renderer above, so the two are never loaded in one process. -->
    <PackageVersion Include="RecursiveAI.OneImage.Svg" Version="1.10.0" />
    <!-- Compared against as compiled packages in the benchmarks and the extraction-quality tool; black boxes. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- Layout comparison (bench/OnePdf.Layout.Benchmarks only): compiled packages, public API, black boxes. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="itext" Version="9.8.0" />
    <!-- PDFsharp pulls in an old, flagged copy of this package; the comparison tool pins a patched one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
