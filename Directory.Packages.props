<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Used by the test, benchmark and fuzz projects only. The libraries depend on nothing outside the shared framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.1.0" />
    <!-- Compared against as compiled packages in the benchmarks and the extraction-quality tool; black boxes. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp pulls in an old, flagged copy of this package; the comparison tool pins a patched one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
