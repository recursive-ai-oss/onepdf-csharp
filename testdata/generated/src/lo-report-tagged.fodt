<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls/>
<office:styles><style:style style:name="Standard" style:family="paragraph"><style:text-properties style:font-name="Liberation Serif" fo:font-family="'Liberation Serif'" fo:font-size="12pt"/></style:style><style:style style:name="Heading" style:family="paragraph"><style:text-properties fo:font-family="'Liberation Sans'" fo:font-size="16pt" fo:font-weight="bold"/></style:style></office:styles>
<office:automatic-styles><style:page-layout style:name="PL1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin="2cm"/><style:header-style/><style:footer-style/></style:page-layout>
<style:style style:name="PB" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:break-before="page"/></style:style>
<style:style style:name="CB" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:break-before="column"/></style:style>
<style:style style:name="Sect2" style:family="section"><style:section-properties><style:columns fo:column-count="2" fo:column-gap="1cm"/></style:section-properties></style:style>
<style:style style:name="Tbl" style:family="table"><style:table-properties style:width="12cm" table:align="left"/></style:style>
<style:style style:name="Cell" style:family="table-cell"><style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="PL1"><style:header><text:p>Quarterly Harbor Report</text:p></style:header><style:footer><text:p>Prepared for internal circulation</text:p></style:footer></style:master-page></office:master-styles>
<office:body><office:text>
<text:h text:style-name="Heading" text:outline-level="1">Summary</text:h>
<text:p text:style-name="Standard">The harbor town woke slowly. Fishing boats rocked against their moorings while gulls argued over the morning catch.</text:p>
<text:p text:style-name="Standard">Read the <text:a xlink:href="https://example.org/report" xlink:type="simple">full report online</text:a> for more.</text:p>
<text:list><text:list-item><text:p>Boats serviced</text:p></text:list-item><text:list-item><text:p>Cargo weighed</text:p></text:list-item><text:list-item><text:p>Lamps replaced</text:p></text:list-item></text:list>
<table:table table:name="T1" table:style-name="Tbl"><table:table-column table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>Month</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>Boats</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>Tons</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>April</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>31</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>120</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>May</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>44</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>175</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>June</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>52</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p>210</text:p></table:table-cell></table:table-row></table:table>
<text:p text:style-name="PB"><text:bookmark-start text:name="second"/>Second page<text:bookmark-end text:name="second"/></text:p>
<text:p text:style-name="Standard">Section two begins on a new page. It repeats nothing from the first page and uses entirely different words so that extraction errors are easy to spot.</text:p>
<text:p text:style-name="Standard">Quartz, jasper, and obsidian were sorted into wooden trays by an apprentice who hummed while he worked.</text:p>
</office:text></office:body></office:document>
