<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The target runs under libFuzzer with SharpFuzz coverage instrumentation, not as a trimmed app. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The signature target signs its starting files with the test kit that the unit tests use. -->
    <Compile Include="../../tests/OnePdf.Tests/Signatures/SigKit.cs" Link="Signatures/SigKit.cs" />
    <Compile Include="../../tests/OnePdf.Tests/Signatures/SigKit.Pdf.cs" Link="Signatures/SigKit.Pdf.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePdf/OnePdf.csproj" />
  </ItemGroup>

</Project>
