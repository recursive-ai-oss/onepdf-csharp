<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Layout.Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Runs under libFuzzer with SharpFuzz coverage instrumentation, not as a trimmed app. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OnePdf/OnePdf.csproj" />
    <ProjectReference Include="../../src/OnePdf.Layout/OnePdf.Layout.csproj" />
  </ItemGroup>

</Project>
