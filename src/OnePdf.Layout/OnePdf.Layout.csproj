<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(LibName).Layout</AssemblyName>
    <RootNamespace>$(LibName).Layout</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Layout</PackageId>
    <Description>Fluent page layout for OnePDF: write documents in code with containers, tables, lists, shaped and bidirectional text, images, headers, footers and page numbers, and get a tagged PDF. Built on RecursiveAI.OneFont and RecursiveAI.OnePdf. No dependencies beyond .NET and the OneFont and OnePDF packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>pdf;layout;document-generation;tagged-pdf;nativeaot;trimmable</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Layout.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OnePdf/OnePdf.csproj" />
    <ProjectReference Include="../OnePdf.Fonts/OnePdf.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family's shaping package: the one PackageReference a library project here may have. -->
    <PackageReference Include="RecursiveAI.OneFont" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
